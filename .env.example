# =============================================================================
# LinguaProctor - Environment Configuration
# =============================================================================
# Copy this file to .env. As shipped (endpoints commented out) the API runs
# fully offline; uncomment and fill in endpoints to connect to Azure.
# NEVER commit .env to version control.
#
# Every variable below is read by src/config.py (prefix + field name).
# All Azure settings are optional: without them the API still starts, the
# HITL / audit / admin endpoints work, and AI endpoints return HTTP 503.

# Authentication: Microsoft Entra ID by default. Locally, run `az login` (your
# account needs the data-plane roles granted by `azd provision`); in Azure the
# container app's managed identity is used. Keys are only for resources that
# still allow local auth; the provisioned resources do NOT.
# After `azd provision`, infra/scripts/write-env.* writes these to .env.azure.

# --- Azure OpenAI (written scoring, oral scoring, content generation) ---
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=                     # optional; omit for Entra ID
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding
# true for GPT-5.x / o-series (no temperature, uses max_completion_tokens)
AZURE_OPENAI_CHAT_REASONING_MODEL=true
# AZURE_OPENAI_REASONING_EFFORT=low         # optional

# --- Azure AI Speech (oral speech-to-text) ---
# AZURE_SPEECH_ENDPOINT=https://your-speech.cognitiveservices.azure.com/
AZURE_SPEECH_REGION=uaenorth
# AZURE_SPEECH_KEY=                         # optional; omit for Entra ID

# --- Azure Cosmos DB: durable append-only audit trail (in-memory when unset) ---
# COSMOS_ENDPOINT=https://your-cosmos.documents.azure.com:443/
COSMOS_DATABASE_NAME=linguaproctor
COSMOS_AUDIT_CONTAINER=audit
# COSMOS_KEY=                               # optional; omit for Entra ID

# --- Azure Application Insights ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# --- Application Settings ---
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_MAX_CONCURRENT_SCORING=5
# HITL triage thresholds (AI confidence 0..1)
APP_AUTO_APPROVE_THRESHOLD=0.90
APP_SCORING_CONFIDENCE_THRESHOLD=0.75
APP_MANDATORY_REVIEW_THRESHOLD=0.60
# Fraction of auto-approvable results randomly held for human audit
APP_AUDIT_SAMPLE_RATE=0.05

# --- Dashboard ---
LINGUAPROCTOR_API_URL=http://localhost:8000
